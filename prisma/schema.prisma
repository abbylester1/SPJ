generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Creator {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  photoUrl    String?
  editToken   String   @unique
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())
  socials     SocialAccount[]
  campaigns   Campaign[]
}

model SocialAccount {
  id               String   @id @default(cuid())
  creator          Creator  @relation(fields: [creatorId], references: [id])
  creatorId        String
  platform         String // instagram | tiktok | strava | other
  handle           String
  profileUrl       String
  followersClaimed Int
  engagementRate   Float?
  verified         Boolean  @default(false)
  verifiedFollowers Int?
  reviewedAt       DateTime?
  createdAt        DateTime @default(now())
}

model Campaign {
  id            String   @id @default(cuid())
  slug          String   @unique
  creator       Creator  @relation(fields: [creatorId], references: [id])
  creatorId     String
  category      String   @default("sports") // sports | events | life | content | builder
  activityTitle String // "Running HYROX Dubai"
  eventDate     DateTime
  description   String
  socialLinks   String // comma separated
  images        String // comma separated urls
  eventTier     String   @default("local") // local | regional | major
  status        String   @default("pending_review") // pending_review | approved | rejected
  rejectReason  String?
  createdAt     DateTime @default(now())
  slots         Slot[]
  inquiries     Inquiry[]
}

model Slot {
  id             String   @id @default(cuid())
  campaign       Campaign @relation(fields: [campaignId], references: [id])
  campaignId     String
  name           String // Chest, Back, Instagram Post, The Van's Left Panel...
  whatYouGet     String?
  suggestedMin   Int?
  suggestedMax   Int?
  price          Int // fixed price, or the starting bid when isAuction is true
  isAuction      Boolean  @default(false)
  auctionEndsAt  DateTime?
  status         String   @default("available") // available | pending | sold
  createdAt      DateTime @default(now())
  sponsorship    Sponsorship?
  bids           Bid[]
}

model Bid {
  id          String   @id @default(cuid())
  slot        Slot     @relation(fields: [slotId], references: [id])
  slotId      String
  bidderName  String
  company     String
  email       String
  amount      Int
  createdAt   DateTime @default(now())
}

model Sponsorship {
  id              String   @id @default(cuid())
  slot            Slot     @relation(fields: [slotId], references: [id])
  slotId          String   @unique
  sponsorName     String
  company         String
  email           String
  logoUrl         String?
  amount          Int
  stripeSessionId String?  @unique
  paymentStatus   String   @default("pending") // pending | paid | refunded
  createdAt       DateTime @default(now())
}

model Inquiry {
  id          String    @id @default(cuid())
  campaign    Campaign? @relation(fields: [campaignId], references: [id])
  campaignId  String?
  brandName   String
  company     String
  email       String
  objective   String
  budgetRange String?
  status      String    @default("new") // new | contacted | closed
  createdAt   DateTime  @default(now())
}
